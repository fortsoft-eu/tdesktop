using "ui/basic.style";
using "ui/widgets/widgets.style";
using "info/info.style";
using "boxes/boxes.style";

settingsExperimentalTextStyle: TextStyle(defaultTextStyle) {
	font: font(11px "Tahoma");
}
settingsTopBarTitle: FlatLabel(infoApplicationTitle) {
	textFg: classicMenuText;
}
settingsIntroScroll: ScrollArea(defaultScrollArea) {
	shColor: transparent;
}

settingsRowPadding: 4px;
settingsTwoLineRowHeight: 32px;

settingsButton: SettingsButton(infoProfileButton) {
	style: settingsExperimentalTextStyle;
	padding: margins(48px, settingsRowPadding, 16px, settingsRowPadding);
	iconLeft: 14px;
}
settingsButtonRightLabelSpoiler: SettingsButton(settingsButton) {
	style: settingsExperimentalTextStyle;
	rightLabel: FlatLabel(defaultSettingsRightLabel) {
		palette: TextPalette(defaultTextPalette) {
			spoilerFg: windowActiveTextFg;
		}
	}
}
settingsButtonNoIcon: SettingsButton(settingsButton) {
	style: settingsExperimentalTextStyle;
	padding: margins(16px, settingsRowPadding, 16px, settingsRowPadding);
}
settingsOptionPadding: 3px;
settingsCompactToggle: SettingsButton(settingsButtonNoIcon) {
	height: classicCheckSize;
	padding: margins(16px, settingsOptionPadding, 16px, settingsOptionPadding);
}
settingsTtlOption: SettingsButton(settingsCompactToggle) {
	padding: margins(36px, settingsOptionPadding, 16px, settingsOptionPadding);
}
settingsButtonLight: SettingsButton(settingsButton) {
	style: settingsExperimentalTextStyle;
	textFg: lightButtonFg;
	textFgOver: lightButtonFgOver;
}
editContactActionButton: SettingsButton(settingsButtonLight) {
	textBg: classicControlBg;
	textBgOver: classicControlBg;
	textFg: classicMenuText;
	textFgOver: classicMenuText;
}
settingsButtonLightNoIcon: SettingsButton(settingsButtonLight, settingsButtonNoIcon) {
	style: settingsExperimentalTextStyle;
}
settingsButtonNoIconLocked: SettingsButton(settingsButtonNoIcon) {
	style: settingsExperimentalTextStyle;
	toggle: Toggle(infoProfileToggle) {
		lockIcon: icon {{ "info/info_rights_lock", menuIconFg }};
	}
	toggleOver: Toggle(infoProfileToggleOver) {
		lockIcon: icon {{ "info/info_rights_lock", menuIconFgOver }};
	}
}
settingsButtonActive: SettingsButton(infoMainButton, settingsButton) {
	style: settingsExperimentalTextStyle;
}
settingsAttentionButton: SettingsButton(settingsButtonNoIcon) {
	style: settingsExperimentalTextStyle;
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFgOver;
}
editContactAttentionButton: SettingsButton(settingsAttentionButton) {
	textBg: classicControlBg;
	textBgOver: classicControlBg;
}
settingsAttentionButtonWithIcon: SettingsButton(settingsButton) {
	style: settingsExperimentalTextStyle;
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFgOver;
}
settingsExperimentalTitle: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
	style: settingsExperimentalTextStyle;
}
settingsExperimentalAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 100px;
